{
  "name": "@aviaratech/release-social",
  "version": "1.0.1",
  "description": "Publish GitHub Releases to X and LinkedIn with preview-first, duplicate-resistant delivery",
  "homepage": "https://github.com/aviaratech/release-social#readme",
  "bugs": {
    "url": "https://github.com/aviaratech/release-social/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aviaratech/release-social.git"
  },
  "bin": {
    "release-social": "./dist/cli/bin.js"
  },
  "files": [
    "dist",
    "action-dist",
    "action.yml",
    "templates",
    "docs",
    "examples",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./providers/x": {
      "types": "./dist/providers/x/index.d.ts",
      "default": "./dist/providers/x/index.js"
    },
    "./providers/linkedin": {
      "types": "./dist/providers/linkedin/index.d.ts",
      "default": "./dist/providers/linkedin/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "format": "oxfmt src tests package.json tsconfig.json tsconfig.build.json vitest.config.ts .oxlintrc.json .oxfmtrc.json",
    "format:check": "oxfmt --check src tests package.json tsconfig.json tsconfig.build.json vitest.config.ts .oxlintrc.json .oxfmtrc.json",
    "lint": "oxlint src tests vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "checks": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run check:action-bundle",
    "bundle:action": "node scripts/build-action.mjs",
    "check:action-bundle": "node scripts/check-action-bundle.mjs"
  },
  "dependencies": {
    "oauth": "0.10.2",
    "twitter-text": "3.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/oauth": "0.9.6",
    "@types/twitter-text": "3.1.10",
    "esbuild": "0.28.2",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "6.0.2",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0"
}
